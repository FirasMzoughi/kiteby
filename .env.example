# Copy this file to .env and fill in your own Supabase project values.
#   cp .env.example .env
#
# Find both values in the Supabase dashboard under:
#   Project Settings > API
#
# SUPABASE_KEY must be the PUBLISHABLE key (sb_publishable_...) or the legacy
# anon/public key. NEVER use the service_role / secret key in a Flutter app --
# it bypasses every Row Level Security policy and ships inside the APK.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
